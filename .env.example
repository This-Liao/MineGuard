# 可选真实模型规划配置。此文件仅作模板，项目不会自动加载 .env；请显式注入进程环境变量。
# 真实密钥不得提交到 Git，也不要发送到聊天中。
MINEGUARD_LLM_PROVIDER=deterministic
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
# 零表示未授权；真实评测建议使用 scripts/run-real-eval.ps1 显式传入次数。
MINEGUARD_LLM_MAX_CALLS=0
MINEGUARD_LLM_MAX_OUTPUT_TOKENS=2048
MINEGUARD_LLM_TIMEOUT_SECONDS=60
MINEGUARD_LLM_THINKING=disabled

# 可选 PostgreSQL 配置
SPRING_PROFILES_ACTIVE=
DATABASE_URL=jdbc:h2:file:./data/runtime/mineguard;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver

# 首次启动显式设置管理员账号与强密码；部署后清除启动凭据。
MINEGUARD_BOOTSTRAP_USERNAME=
MINEGUARD_BOOTSTRAP_PASSWORD=
MINEGUARD_SESSION_SECONDS=3600
MINEGUARD_APPROVAL_SECONDS=600
MINEGUARD_LEASE_SECONDS=30
MINEGUARD_NODE_ID=local
# 接入实际业务数据库时必须关闭演示初始化。
MINEGUARD_DEMO_DATA_ENABLED=true

# 多实例验收使用独立 HTTP 契约服务；mock 只用于单机离线评测。
MINEGUARD_INDUSTRIAL_TYPE=mock
MINEGUARD_INDUSTRIAL_BASE_URL=http://127.0.0.1:18081
MINEGUARD_INDUSTRIAL_TOKEN=
MINEGUARD_WRITE_CAMERAS=camera-03,camera-08,camera-17
MINEGUARD_WRITE_ALGORITHMS=intrusion_detection,no_helmet,personnel_violation

# 可选 Milvus REST v2 适配器
# 语义向量配置独立于规划模型，绝不复用 OPENAI_API_KEY。
MINEGUARD_EMBEDDING_PROVIDER=hashing
MINEGUARD_EMBEDDING_BASE_URL=http://127.0.0.1:18082/v1
MINEGUARD_EMBEDDING_API_KEY=
MINEGUARD_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MINEGUARD_EMBEDDING_DIMENSIONS=512
MINEGUARD_EMBEDDING_TIMEOUT_SECONDS=60
MINEGUARD_EMBEDDING_MAX_REQUESTS=1000
# BGE 中文检索仅为 query 添加此前缀；其他模型须遵循各自说明。
MINEGUARD_EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# 切换模型须使用维度匹配的独立集合并重新索引，不能混合旧哈希向量。
MINEGUARD_VECTOR_STORE=in-memory
MILVUS_URI=http://localhost:19530
