# Optional real-model planning. Keep actual secrets in .env (ignored by Git).
MINEGUARD_LLM_PROVIDER=deterministic
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional PostgreSQL profile
SPRING_PROFILES_ACTIVE=
DATABASE_URL=jdbc:h2:mem:mineguard;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Optional Milvus REST v2 adapter
MINEGUARD_VECTOR_STORE=in-memory
MILVUS_URI=http://localhost:19530
